# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
data/push-tokens.json
data/push-watchlist.json

# push notification data (device tokens — never commit)
data/push-tokens.json
data/push-watchlist.json

# scrape stage transient state (DIC-508): checkpoint/cache are per-run scratch
# data for resuming an interrupted scrape, never a deliverable artifact.
data/scrape-checkpoint.json
data/scrape-cache.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.vercel
scripts/chrome/
scripts/.metadata
