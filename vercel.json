{
  "build": {
    "env": {
      "EXPECTED_VERCEL_BRANCH": "staging",
      "EXPO_PUBLIC_STORE_MVP": "0",
      "EXPO_EXPORT_CLEAR": "1"
    }
  },
  "buildCommand": "bash scripts/ci/vercel-build.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-db",
      "schedule": "0 2 * * *"
    }
  ]
}
