{
  "buildCommand": "expo export --platform web && node scripts/fix-html.js && node scripts/copy-assets.js && node scripts/generate-assetlinks.mjs",
  "outputDirectory": "dist",
  "regions": [
    "hkg1"
  ],
  "fluid": false,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-db",
      "schedule": "0 2 * * *"
    }
  ]
}
