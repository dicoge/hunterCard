# Push notification backend (DIC-390)

# Vercel KV / Upstash Redis — stores push tokens, watchlists, and per-card
# alert cooldown timestamps. Replaces the old GitHub-committed JSON files so
# tokens never land in git history.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret guarding POST /api/push/notify. The endpoint is server-to-server
# only (cron / Vercel cron) and rejects every request when this is unset.
# Set the SAME value on Vercel (the API) and in the local scraper's environment.
PUSH_NOTIFY_SECRET=

# Optional override for where the scraper sends alerts (defaults to prod).
# PUSH_NOTIFY_URL=https://holocard-hunter.vercel.app/api/push/notify

# Google OAuth — 每個平台一個 OAuth client ID（同一 GCP 專案，皆為公開值）。
# 見 docs/AUTH_SETUP.md 的「Google 登入設定」與 Android SHA-1 登錄步驟。
# native SDK 以 Web client ID 當 webClientId，因此拿到的 id_token audience 一律為
# Web client。**後端 /api/auth/login 只接受伺服器 Web client ID 作為唯一 audience**——
# 刻意不接受 iOS / Android client ID（它們沒有 client secret，接受會擴大 token 來源）。
# iOS / Android client ID 僅供原生 SDK 的平台設定，不是後端 audience。
# Web client：Web 登入用，且為 mobile 後端驗證 id_token 的**唯一** audience。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# iOS client：Bundle ID com.dicoge.holohunter（僅原生設定，非後端 audience）。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Android client：Package com.dicoge.holohunter + 各 keystore SHA-1（僅原生設定，非後端 audience）。
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# 後端也接受不帶 EXPO_PUBLIC_ 前綴的 GOOGLE_WEB_CLIENT_ID 作為 audience（可選）；
# 未設定任何 Web client ID 時後端 fail-closed（501 AUTH_NOT_CONFIGURED）。
# GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# App session 簽章密鑰（後端權威簽發 HS256 access/refresh token）。
# /api/auth/login 在此未設定時 fail-closed 回 501 SESSION_NOT_CONFIGURED——
# 不會簽發任何 session。僅設定於 Vercel，勿提交。以高熵隨機值產生，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# 使用者 / 身份 / 登入 nonce 儲存亦使用上方的 Vercel KV（KV_REST_API_*）：
#   auth:identity:{provider}:{sub} → 內部 user 對應（身份鍵為 provider+sub，非 email）
#   auth:user:{internalId}         → 後端權威 user 資料
#   auth:nonce:{nonce}             → server-bound 一次性登入 nonce（TTL 300s，GETDEL 原子消費，防重放）
# 未設定 KV 時 /api/auth/nonce fail-closed 回 501 NONCE_STORE_NOT_CONFIGURED。
