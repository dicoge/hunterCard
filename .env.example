# Push notification backend (DIC-390)

# Vercel KV / Upstash Redis — stores push tokens, watchlists, and per-card
# alert cooldown timestamps. Replaces the old GitHub-committed JSON files so
# tokens never land in git history.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret guarding POST /api/push/notify. The endpoint is server-to-server
# only (cron / Vercel cron) and rejects every request when this is unset.
# Set the SAME value on Vercel (the API) and in the local scraper's environment.
PUSH_NOTIFY_SECRET=

# Optional override for where the scraper sends alerts (defaults to prod).
# PUSH_NOTIFY_URL=https://holocard-hunter.vercel.app/api/push/notify

# Google OAuth (all client IDs are PUBLIC values — the only Google secret is the
# Web client secret, which the app never uses and must never be committed).
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID — the Web/"server" OAuth client. Used by the
#   web browser sign-in AND as the `webClientId` for native Android Google
#   Sign-In (Credential Manager), so the Android ID token's `aud` is this Web
#   client — the audience the backend verifies. This is the id the server MUST
#   have to accept Android/web logins.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID — dedicated iOS OAuth client (its own
#   reversed-client-id URL scheme) for native iOS Google Sign-In.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID — dedicated Android OAuth client
#   (package `com.dicoge.holohunter` + signing-cert SHA-1). It AUTHORIZES the
#   native Android flow in Google Console; it is NOT passed to the app at
#   runtime (the library uses the Web client id above). The server accepts it as
#   an audience for defense-in-depth. Register a SHA-1 for every keystore that
#   signs the app — most importantly the Play App Signing key (see
#   docs/Auth-Google-Login-Design.md 交付 F).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Store MVP release gate (DIC-908). Allowlist / fail-closed: hides advanced
# features (buy-back price, price spread, trend & prediction, news, YouTube
# stats, watchlist alerts, subscription) from the store build.
#   1 / true  → Store MVP ON  (hide advanced surfaces)
#   0 / false → Store MVP OFF (full app)
#   unset     → native store builds default ON (fail-closed); web defaults OFF
#               so the existing web production site keeps its full feature set.
# eas.json's preview/production profiles already pin this to "1".
# EXPO_PUBLIC_STORE_MVP=1
